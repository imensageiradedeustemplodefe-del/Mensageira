# Banco de dados (Prisma Postgres / Vercel Postgres)
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Chave (32+ caracteres) para criptografar e-mails/telefones dos pedidos de oração
CONTACT_ENCRYPTION_KEY=""

# Web Push (VAPID) — gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:imensageiradedeustemplodefe@gmail.com"

# Segredo para o cron de notificações (Vercel Cron envia Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# Admin inicial criado pelo seed
